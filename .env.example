NODE_ENV=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# Keep local builds on a unique tag. Production should pin a numbered release
# image such as ghcr.io/macstered/iptvmaster:0.1.0, never `latest`.
IPTVMASTER_IMAGE=iptvmaster:local
PLAYLIST_REFRESH_ENABLED=true
PLAYLIST_REFRESH_INTERVAL_MINUTES=120
PLAYLIST_REFRESH_INITIAL_DELAY_SECONDS=30
EPG_REFRESH_ENABLED=true
EPG_REFRESH_INTERVAL_MINUTES=720
EPG_REFRESH_INITIAL_DELAY_SECONDS=60

# Retry only timeouts, network interruptions, throttling, and provider 5xx
# responses. Invalid feeds and credential/client errors fail immediately.
PROVIDER_RETRY_ATTEMPTS=3
PROVIDER_RETRY_INITIAL_DELAY_SECONDS=2
PROVIDER_RETRY_MAX_DELAY_SECONDS=30

# Daily internal cleanup removes expired administrator sessions. Current XMLTV
# rows are replaced transactionally on each accepted EPG refresh.
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=1440
MAINTENANCE_INITIAL_DELAY_SECONDS=300

# Used by scripts/backup-postgres.sh when run interactively.
IPTVMASTER_BACKUP_DIR=./backups
IPTVMASTER_BACKUP_RETENTION_DAYS=14

# Administrator sessions last seven days by default. Enable Secure cookies only
# when the browser reaches IPTVMaster through HTTPS.
IPTVMASTER_SESSION_HOURS=168
IPTVMASTER_SECURE_COOKIES=false

# Replace these before a production deployment.
POSTGRES_DB=iptvmaster
POSTGRES_USER=iptvmaster
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://iptvmaster:@postgres:5432/iptvmaster

# Generate with: openssl rand -base64 32
IPTVMASTER_MASTER_KEY=replace-with-a-base64-encoded-32-byte-key

# Provider and guide feeds are fetched from operator-supplied URLs. Every
# request and every redirect hop must resolve to a public address, so a hostile
# feed cannot redirect the server into probing your own network. If you host a
# playlist or XMLTV generator on your own network, name its network here as a
# comma-separated CIDR list, for example 192.168.1.0/24,10.8.0.0/16. Loopback,
# link-local (including the cloud metadata address), multicast, and reserved
# ranges are refused even when listed. On dual-stack hosts a LAN name can
# resolve to an IPv6 unique-local address, so include an IPv6 range such as
# fd00::/8 if a LAN feed fails to load with an address you do not recognise.
IPTVMASTER_ALLOWED_SOURCE_CIDRS=

# Deprecated: allowed every private range at once. Prefer the CIDR list above.
IPTVMASTER_ALLOW_PRIVATE_SOURCE_ADDRESSES=false

# Provider credentials are entered through the application setup flow later.
# Never place a real provider URL in this file or commit it to Git.
